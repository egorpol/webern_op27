# Local settings, environments and Python/Jupyter caches.
.codex/
.agents/
.env
.env.*
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Facsimile images and the source PDF stay local; pages.json records their hashes.
/facsimiles/**/*.png
/facsimiles/**/*.pdf

# Source encodings (KernScores, cross-check encodings) are cited by URL + SHA-256, never committed.
/sources/kern/
/sources/crosscheck/

# Validation run outputs.
/validation/runs/

# Assembled GitHub Pages site (scripts/build_site.py).
/_site/
