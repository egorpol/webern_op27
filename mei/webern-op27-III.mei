                     <persName auth="GND" auth.uri="https://d-nb.info/gnd/118629786" codedval="118629786">Anton Webern</persName>
                  </composer>
                  <edition>First edition (1937); the copy used was printed from the original plates in 1965 or later</edition>
                  <imprint>
                     <pubPlace>Wien</pubPlace>
                     <publisher>Universal Edition</publisher>
                     <date isodate="1937">1937</date>
                  </imprint>
                  <identifier type="plate">U.E. 10881</identifier>
                  <biblScope unit="page" from="7" to="11">pp. 7–11</biblScope>
                  <ref type="digital-facsimile" target="https://imslp.org/wiki/Special:ImagefromIndex/28271">IMSLP file 28271</ref>
                  <annot type="copy">
                     <p>The copy used is the scan in IMSLP file 28271 (PDF of printed pages 3–11, SHA-256 d604c08ab797818f414a83fa4047eb2eb3c52ba6c74a47ce966e0a9c273ab330). Its first page carries the 1965 copyright renewal, so it was printed in 1965 or later; a first-issue copy of 1937 has not been compared.</p>
                  </annot>
                  <annot type="paratext">
                     <p>p. 7, head: page number "7"; movement numeral "III".</p>
                     <p>pp. 8–11: page numbers "8" to "11".</p>
                     <p>pp. 7–11, foot: "U.E. 10881"; p. 11, foot, right: "Waldheim-Eberle, Wien VII." (printer).</p>
                  </annot>
                  <availability>
                     <useRestrict>Scan uploaded to IMSLP by JacopoTore (2017); scanner unknown. IMSLP lists the file as “Public Domain - Non-PD US”. The page images are not redistributed with this edition; the facsimile links point to local renderings of the PDF.</useRestrict>
                  </availability>
               </bibl>
            </source>
